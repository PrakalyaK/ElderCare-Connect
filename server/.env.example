PORT=5000
NODE_ENV=development
JWT_SECRET=eldercare_super_secure_jwt_secret_promptwars_2026

# PostgreSQL Connection String (Optional: Neon / Supabase / Railway / Local Postgres)
# If left empty, ElderCare Connect automatically uses an embedded PostgreSQL instance (PGlite) with persistence!
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/eldercare?sslmode=require
DATABASE_URL=

# Nodemailer SMTP Configuration (Optional)
# If left empty, Nodemailer uses automated Ethereal test inbox or in-app notification logging with live preview URLs!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ElderCare Connect" <notifications@eldercareconnect.app>
SMTP_SECURE=false

# Client URL (for CORS and reset links)
CLIENT_URL=http://localhost:5173
